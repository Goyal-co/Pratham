# Optional. Prefer reusing apps/admin/.env.local instead of maintaining two files:
#
#   ENV_FILE=apps/admin/.env.local docker compose up -d --build
#   ENV_FILE=apps/admin/.env.local docker compose -f docker-compose.aws.yml up -d --build
#
# Compose also auto-reads a repo-root `.env` for ${VAR} substitution (build-args).
# If you use ENV_FILE=apps/admin/.env.local, either:
#   - copy/symlink it to `.env`, or
#   - export NEXT_PUBLIC_* in the shell before `docker compose build`

# Compose-only knobs (not required in apps/admin/.env.local)
# RUN_MIGRATIONS=false
# APP_PORT=3000
# AHARIVA_IMAGE=ahariva-admin:latest
# ENV_FILE=apps/admin/.env.local
