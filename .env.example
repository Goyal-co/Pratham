# Copy secrets to apps/admin/.env.local (never commit real passwords)

# Hosted Postgres (Neon / RDS / etc.)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pratham?sslmode=require
DATABASE_SSL=true

# Local Docker (npm run db:up) — use instead when developing locally:
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/pratham
# DATABASE_SSL=false

JWT_SECRET=change-me-in-production-use-long-random
BOOTSTRAP_SECRET=change-me
CRON_SECRET=change-me
ALLOW_BOOTSTRAP=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: student on its own subdomain (same Vercel project, two domains)
# NEXT_PUBLIC_STUDENT_URL=https://app.yourdomain.com
# NEXT_PUBLIC_APP_URL=https://admin.yourdomain.com

# Web push (student + admin PWA) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gmail.com


# Optional seed overrides (defaults: admin@gmail.com / Admin@1234)
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=Admin@1234
# ADMIN_NAME=Tiffin Admin

# Optional: email password-reset links (https://resend.com)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=noreply@yourdomain.com

# Menu image storage - pick one (auto: Blob -> S3 -> local public/uploads)
# MEDIA_DRIVER=auto
# MEDIA_DRIVER=blob
# MEDIA_DRIVER=s3
# MEDIA_DRIVER=local

# Option A: Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Option B: S3 / R2 / MinIO (works with AWS or S3-compatible)
# S3_BUCKET=ahariva-menu
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional S3-compatible endpoint (Cloudflare R2, MinIO, etc.)
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# Public base URL for browser access (CDN / R2 public domain / CloudFront)
# S3_PUBLIC_URL=https://media.yourdomain.com
# Optional object ACL only if your bucket still uses ACLs (usually leave unset)
# S3_OBJECT_ACL=public-read
