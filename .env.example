# Copy to apps/admin/.env.local (never commit real passwords)

# Local Docker
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/pratham
# DATABASE_SSL=false

# Production / Vercel / RDS
DATABASE_SSL=true

JWT_SECRET=change-me-in-production-use-long-random
BOOTSTRAP_SECRET=change-me
CRON_SECRET=change-me
ALLOW_BOOTSTRAP=false

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Student app
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
