# Copy secrets to apps/admin/.env.local (never commit real passwords)

# Hosted Postgres (Neon / RDS / etc.)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pratham?sslmode=require
DATABASE_SSL=true

# Local Docker (npm run db:up) — use instead when developing locally:
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/pratham
# DATABASE_SSL=false

JWT_SECRET=change-me-in-production-use-long-random
BOOTSTRAP_SECRET=change-me
CRON_SECRET=change-me
ALLOW_BOOTSTRAP=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: student on its own subdomain (same Vercel project, two domains)
# NEXT_PUBLIC_STUDENT_URL=https://app.yourdomain.com
# NEXT_PUBLIC_APP_URL=https://admin.yourdomain.com

# Web push (student + admin PWA) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gmail.com


# Optional seed overrides (defaults: admin@gmail.com / Admin@1234)
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=Admin@1234
# ADMIN_NAME=Rotatinal Admin
