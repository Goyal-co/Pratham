# Hosted Postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pratham?sslmode=require
DATABASE_SSL=true

# Local Docker (npm run db:up):
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/pratham
# DATABASE_SSL=false

JWT_SECRET=change-me
BOOTSTRAP_SECRET=change-me
CRON_SECRET=change-me
ALLOW_BOOTSTRAP=false
# Used by npm run db:seed:admin and /api/seed-admin
ADMIN_EMAIL=titanscortex@gmail.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Titans Cortex
# Admin origin (desk PWA). Locally both apps share this host via / and /app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional student subdomain (separate installable PWA), e.g. https://app.yourdomain.com
# NEXT_PUBLIC_STUDENT_URL=https://app.yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gmail.com

# Required for forgot-password (link emailed only — never returned in API)
# https://resend.com — EMAIL_FROM must be a verified sender/domain
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=noreply@yourdomain.com

# Menu images — auto picks S3 → Blob → local public/uploads
# Private buckets are served via /api/media/file/... (no public ACL needed)
# MEDIA_DRIVER=auto
# S3_REGION=ap-south-1
# S3_BUCKET=goyalco-prod-assets
# S3_PREFIX=Ahariva
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional fallback: Vercel Blob
# BLOB_READ_WRITE_TOKEN=

